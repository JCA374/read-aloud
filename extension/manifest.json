{
  "manifest_version": 3,
  "name": "Neural Voices",
  "version": "0.2.0",
  "description": "Reads web pages aloud with natural Piper voices that run inside your browser. English and Swedish. Your text never leaves your computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:5123/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "catalog.js",
      "common.js",
      "engine/host.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Neural Voices",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "read": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read selection or page / pause / resume"
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop reading"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "neural-voices@jca374.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
